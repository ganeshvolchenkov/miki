# Copy this file to .env and fill in your own values. Never commit the real .env (it's gitignored).

# --- Required ---
OPENAI_API_KEY=

# --- Core ---
MIKI_MODEL=gpt-4o-mini
# development (verbose/local) or production (used on the always-on server)
MIKI_ENV=development
# Folder for the Obsidian graph vault. On the server this is the vault Syncthing mirrors
# back to your laptop's real Obsidian vault -- see docs/deploy-contabo.md.
OBSIDIAN_VAULT_PATH=obsidian/

# --- Brain & hands (Miki's brain on the server, your laptop as her hands) ---
# One shared secret, the SAME value in the server's .env and the laptop's .env. Make one with:
#   python -m app.link token
MIKI_LINK_TOKEN=
# LAPTOP ONLY: where the brain lives (the SSH login you already use). Setting this turns the laptop into
# a thin client: the dashboard shows the server's brain and /focus runs the laptop's screens. Leave it
# EMPTY on the server.
MIKI_SERVER=
# Optional: MIKI_SSH_KEY=C:\Users\you\.ssh\id_ed25519   MIKI_SSH_PORT=22
# Optional ports: MIKI_LINK_PORT=8765 (server, loopback only)  MIKI_LINK_LOCAL_PORT=18765 (laptop end of the tunnel)

# --- Telegram bot ---
# Leave BLANK on any machine that is not the one 24/7 instance -- two processes polling
# the same bot token at once will fight each other (409 conflicts, duplicate replies).
TELEGRAM_BOT_TOKEN=

# --- Google Calendar / Drive (optional) ---
MIKI_GOOGLE_CALENDAR_ID=primary
MIKI_GOOGLE_DRIVE_FOLDER_NAME=
# MIKI_GOOGLE_CREDENTIALS_PATH=data/google_calendar/credentials.json
# MIKI_GOOGLE_TOKEN_PATH=data/google_calendar/token.json
# MIKI_GOOGLE_MAPS_API_KEY=
# MIKI_CALENDAR_ENABLED=true
# MIKI_CALENDAR_REQUIRE_CREATE_CONFIRMATION=true

# --- Weather (optional) ---
# MIKI_WEATHER_ENABLED=true
# WEATHER_PROVIDER=open-meteo
# WEATHER_API_KEY=
# WEATHER_DEFAULT_LOCATION=Amsterdam
# WEATHER_UNITS=metric

# --- Memory / RAG tuning (optional, defaults are sane) ---
# MIKI_TIMEZONE=Europe/Amsterdam
# MIKI_QUIET_HOURS=23:00-08:00
# MIKI_RAG_ENABLED=true
# MIKI_MEMORY_INTELLIGENCE_ENABLED=true

# --- Focus mode (optional; only does anything on a Windows desktop with a real screen) ---
# MIKI_FOCUS_BAN=
# MIKI_FOCUS_RECAP_TIME=21:00

# --- Day planner (/plan) ---
# The model that reads "study 5h, gym, home by 8" into a plan. It runs a few times a day, so it can be stronger
# than the chat model: gpt-4.1-nano was tested and dropped items from requests.
# MIKI_PLAN_MODEL=gpt-4.1-mini
# MIKI_PLAN=0                      # switch /plan off
